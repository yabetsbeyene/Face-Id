# --- Database ---
DATABASE_URL=postgresql+asyncpg://faceid:faceid@localhost:5432/faceid_db

# --- FAISS ---
FAISS_INDEX_PATH=faiss_index/data/faiss.index
FAISS_ID_MAP_PATH=faiss_index/data/id_map.json
EMBEDDING_DIM=512

# --- Recognition ---
# Cosine similarity cutoff. Below this, we report "no match" instead of a false positive.
MATCH_THRESHOLD=0.42

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Match email alerts ---
# Fill these values before testing email delivery. For Gmail, use an App
# Password, not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
DEFAULT_ALERT_EMAIL=
EMAIL_ALERT_COOLDOWN_SECONDS=300
