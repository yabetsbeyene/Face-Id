# --- Database ---
DATABASE_URL=postgresql+asyncpg://faceid:faceid@localhost:5432/faceid_db

# --- FAISS ---
FAISS_INDEX_PATH=faiss_index/data/faiss.index
FAISS_ID_MAP_PATH=faiss_index/data/id_map.json
EMBEDDING_DIM=512

# --- Recognition ---
# Cosine similarity cutoff. Below this, we report "no match" instead of a false positive.
MATCH_THRESHOLD=0.55

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000